# Base de données PostgreSQL
DATABASE_URL="postgresql://petitpont:petitpont@localhost:5432/petitpont"
# Secret de signature des sessions (32+ caractères aléatoires) — obligatoire en production
AUTH_SECRET="change-me-with-a-long-random-string-0123456789"
# Clé de chiffrement des données sensibles (carnet de développement) : 32 octets en base64
DATA_ENCRYPTION_KEY=""
NEXT_PUBLIC_APP_NAME="Petit Pont"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Coach IA (Claude). Sans clé : le coach répond en mode « règles » (moteur déterministe).
ANTHROPIC_API_KEY=""
COACH_MODEL="claude-opus-5-5"
COACH_EFFORT="low"
# Paiement Stripe. Sans clé : mode démonstration (aucun débit, abonnement simulé).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Compte administrateur créé par le seed
ADMIN_EMAIL="admin@petitpont.local"
ADMIN_PASSWORD="ChangeMoi!2026"
# Informations légales de l'éditeur (mentions légales, CGV, factures). Obligatoires avant publication.
LEGAL_COMPANY=""
