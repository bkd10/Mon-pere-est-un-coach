LEGAL_HOST_NAME=""
LEGAL_HOST_ADDRESS=""
LEGAL_HOST_PHONE=""
LEGAL_DATA_LOCATION=""
LEGAL_MEDIATOR_NAME=""
LEGAL_MEDIATOR_URL=""
LEGAL_MEDIATOR_ADDRESS=""
# Envoi des e-mails de service (confirmation de résiliation, rappel de reconduction). Ex. smtps://user:pass@smtp.exemple.fr:465
SMTP_URL=""
MAIL_FROM=""
# Interrupteurs de la v1 (1 = activé). Désactivés par défaut : coach IA, suivi santé, vidéos partagées entre familles.
